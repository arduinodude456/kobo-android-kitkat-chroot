# Dedicated chroot init: imported generated env contains the release BOOTCLASSPATH.
# NO stock init.rc, init.usb.rc, ueventd, SELinux, sysfs, powerctl or fstab imports.
import /init.environ.rc

on early-init
    mkdir /dev/socket 0755 root root
    mkdir /dev/pts 0755 root root
    mkdir /dev/kobo 0770 system graphics
    mkdir /dev/input 0755 root root

on init
    export LD_PRELOAD /system/lib/libkobofb.so
    export KOBO_FB_WIDTH 600
    export KOBO_FB_HEIGHT 800
    export KOBO_FB_FORMAT RGB565
    export KOBO_FB_FILE /dev/kobo/fb.bin
    export KOBO_FB_META /dev/kobo/fb.meta
    export KOBO_BINDER_LOG /data/local/tmp/kobo-binder.log
    # KitKat logwrapper und iptables brauchen echte PTYs; mkdir /dev/pts allein reicht nicht.
    mount devpts devpts /dev/pts
    symlink /dev/pts/ptmx /dev/ptmx
    # liblog-Ersatz in libkobofb.so (KitKat ohne /dev/log-Logger)
    export KOBO_LOG_FILE /data/local/tmp/android.log
    # zygote crasht beim Preload mit NullPointerException (android.os.Debug / Environment), wenn
    # EXTERNAL_STORAGE fehlt: new File(System.getenv("EXTERNAL_STORAGE")). Das Emulator-init.goldfish.rc,
    # das die Variablen sonst setzt, wird hier nicht benutzt -> selbst exportieren.
    # Folge: zygote stirbt, SF-"onrestart restart zygote" und der Neustart-Kreislauf beginnen.
    export EXTERNAL_STORAGE /storage/emulated/legacy
    export SECONDARY_STORAGE /storage/sdcard1
    symlink /system/etc /etc
    symlink /system/bin /bin
    symlink /data/local/tmp /tmp
    mkdir /mnt 0755 root system
    mkdir /mnt/asec 0700 root system
    mkdir /mnt/obb 0700 root system
    mkdir /storage 0755 root root
    mkdir /storage/emulated 0755 root root
    mkdir /storage/emulated/0 0775 media_rw media_rw
    symlink /storage/emulated/0 /sdcard
    mkdir /cache 0770 system cache
    mkdir /data 0771 system system
    mkdir /data/system 0775 system system
    mkdir /data/system/users 0775 system system
    mkdir /data/system/users/0 0775 system system
    mkdir /data/misc 01771 system misc
    mkdir /data/misc/keystore 0700 keystore keystore
    mkdir /data/misc/keychain 0771 system system
    mkdir /data/misc/systemkeys 0700 system system
    mkdir /data/misc/media 0700 media media
    mkdir /data/data 0771 system system
    mkdir /data/app 0771 system system
    mkdir /data/app-private 0771 system system
    mkdir /data/app-lib 0771 system system
    mkdir /data/app-asec 0700 root root
    mkdir /data/dalvik-cache 0771 system system
    mkdir /data/resource-cache 0771 system system
    mkdir /data/property 0700 root root
    mkdir /data/local 0751 root root
    mkdir /data/local/tmp 0771 shell shell
    # Prozesse mit uid system/media/... (SurfaceFlinger, Shim-Log) muessen hier schreiben koennen.
    chmod 0777 /data/local/tmp
    mkdir /data/tombstones 0771 system system
    mkdir /data/dalvik-cache/profiles 0711 system system
    mkdir /storage/sdcard1 0775 root root
    mkdir /storage/emulated/legacy 0775 root root
    mkdir /data/drm 0770 drm drm
    mkdir /data/mediadrm 0770 mediadrm mediadrm
    mkdir /data/security 0711 system system
    chmod 0666 /dev/binder
    chmod 0666 /dev/ashmem
    chmod 0666 /dev/alarm
    # ---- aus dem Original-init.rc (4.4.4) uebernommen, soweit sie nur den Chroot betreffen ----
    # Nicht uebernommen (wuerden den Kobo-Host veraendern): ueventd, vold, mount-Aktionen (cgroups, tmpfs),
    # write/chown auf /proc, /sys, /proc/sys, hostname/domainname/ifup, powerctl, setcon, console, adbd.
    sysclktz 0
    symlink /system/vendor /vendor
    mkdir /acct 0755 root root
    mkdir /config 0500 root root
    mkdir /mnt/shell 0700 shell shell
    mkdir /mnt/media_rw 0700 media_rw media_rw
    mkdir /mnt/secure 0700 root root
    mkdir /mnt/secure/staging 0700 root root
    mkdir /mnt/secure/asec 0700 root root
    mkdir /dev/fscklogs 0770 root system
    mkdir /cache/recovery 0770 system cache
    mkdir /cache/lost+found 0770 root root
    mkdir /data/lost+found 0770 root root
    mkdir /data/dontpanic 0750 root log
    mkdir /data/misc/adb 02750 system shell
    mkdir /data/misc/bluedroid 0770 bluetooth net_bt_stack
    mkdir /data/misc/bluetooth 0770 system system
    mkdir /data/misc/radio 0770 system radio
    mkdir /data/misc/sms 0770 system radio
    mkdir /data/misc/zoneinfo 0775 system system
    mkdir /data/misc/vpn 0770 system vpn
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/ssh 0750 root shell
    mkdir /data/ssh/empty 0700 root root
    symlink /data/data/com.android.shell/files/bugreports /data/bugreports
    # RLIMIT_NICE (13) wie im Original: sonst "binder: RLIMIT_NICE not set" fuer jeden Binder-Thread
    setrlimit 13 40 40
    setprop ro.hardware kobo_libra_colour
    setprop ro.kernel.qemu 1
    setprop ro.kernel.qemu.gles 0
    setprop ro.hardware.egl android
    setprop ro.bootmode unknown
    setprop ro.factorytest 0
    setprop ro.crypto.state unencrypted
    setprop vold.decrypt trigger_restart_framework
    # KitKat's system_server instantiates its own SurfaceFlinger unless told not to;
    # that would collide with the surfaceflinger service below and leave no display.
    setprop system_init.startsurfaceflinger 0
    setprop debug.sf.nohwcomposer 1
    setprop persist.sys.usb.config none

on post-fs-data
    load_persist_props

on boot
    setprop net.tcp.buffersize.default 4096,87380,110208,4096,16384,110208
    setprop net.tcp.buffersize.wifi    524288,1048576,2097152,262144,524288,1048576
    setprop net.tcp.buffersize.lte     524288,1048576,2097152,262144,524288,1048576
    setprop net.tcp.buffersize.umts    4094,87380,110208,4096,16384,110208
    setprop net.tcp.buffersize.hspa    4094,87380,262144,4096,16384,262144
    setprop net.tcp.buffersize.hsupa   4094,87380,262144,4096,16384,262144
    setprop net.tcp.buffersize.hsdpa   4094,87380,262144,4096,16384,262144
    setprop net.tcp.buffersize.hspap   4094,87380,1220608,4096,16384,1220608
    setprop net.tcp.buffersize.edge    4093,26280,35040,4096,16384,35040
    setprop net.tcp.buffersize.gprs    4092,8760,11680,4096,8760,11680
    setprop net.tcp.buffersize.evdo    4094,87380,262144,4096,16384,262144
    setprop net.tcp.default_init_rwnd 60

on boot
    class_start core
    class_start main

# Tombstones (/data/tombstones) mit Backtrace, falls surfaceflinger/zygote per Signal sterben.
service debuggerd /system/bin/debuggerd
    class main

service servicemanager /system/bin/servicemanager
    class core
    user system
    group system
    onrestart restart healthd
    onrestart restart surfaceflinger
    onrestart restart zygote
    onrestart restart media
    onrestart restart drm

# KitKat BatteryService braucht batteryproperties. healthd muss nach dem Binder-Manager starten,
# sonst beendet sich die Registrierung und system_server stuerzt mit NPE in BatteryService ab.
# Nicht critical: ein healthd-Fehler darf niemals den Kobo-Host neu starten.
service healthd /sbin/healthd
    class core
    disabled

on property:init.svc.servicemanager=running
    start healthd

service surfaceflinger /system/bin/surfaceflinger
    class main
    user system
    group graphics drmrpc
    onrestart restart zygote

# Dummy audio HAL satisfies old framework clients; no Kobo audio device is shared.
service media /system/bin/mediaserver
    class main
    user media
    group audio camera inet net_bt net_bt_admin net_bw_acct drmrpc mediadrm

# KitKat system_server blocks in NetworkManagementService until netd's socket exists.
service netd /system/bin/netd
    class main
    socket netd stream 0660 root system
    socket dnsproxyd stream 0660 root inet
    socket mdns stream 0660 root system

service installd /system/bin/installd
    class core
    socket installd stream 0600 system system

service keystore /system/bin/keystore /data/misc/keystore
    class main
    user keystore
    group keystore drmrpc

service zygote /system/bin/app_process -Xzygote /system/bin --zygote --start-system-server
    class main
    socket zygote stream 0660 root system
    onrestart restart media
    onrestart restart netd

service drm /system/bin/drmserver
    class main
    user drm
    group drm system inet drmrpc

# No critical-service reboot actions and no sys.powerctl trigger. Container
# lifecycle belongs to the Kobo supervisor, not Android's global reboot API.
